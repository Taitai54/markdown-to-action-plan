# API Keys — at least one is required
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional — local Ollama (no API key required if Ollama is running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional — OpenRouter model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — require x-api-secret or Authorization: Bearer on /api/generate and /api/export/docx
# GENERATE_API_SECRET=

# Optional — limits (defaults shown)
# MAX_MARKDOWN_CHARS=400000
# MAX_DOCX_HTML_CHARS=2000000
# LLM_REQUEST_TIMEOUT_MS=180000
